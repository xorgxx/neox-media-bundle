<aside class="neox-media-inspector" data-neox-media-library-target="inspector" hidden>
    <div class="neox-media-preview" data-neox-media-library-target="preview"></div>

    <label>
        Titre
        <input data-neox-media-library-target="title">
    </label>

    <label>
        Texte alternatif
        <input data-neox-media-library-target="alt">
    </label>

    <label>
        Description
        <textarea rows="5" data-neox-media-library-target="description"></textarea>
    </label>

    <div class="neox-media-meta" data-neox-media-library-target="meta"></div>

    <div class="neox-media-inspector-actions">
        <button type="button" data-action="neox-media-library#copyUrl">Copier l'URL</button>
        <button type="button" data-action="neox-media-library#save" data-neox-media-library-target="saveBtn">Enregistrer</button>
        <button type="button" class="danger" data-action="neox-media-library#remove" data-neox-media-library-target="removeBtn">Supprimer</button>
    </div>
</aside>
