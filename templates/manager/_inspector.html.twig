<aside class="neox-media-inspector" data-neox-media-library-target="inspector" hidden>
    <div class="neox-media-preview" data-neox-media-library-target="preview"></div>

    <label>
        Titre
        <input data-neox-media-library-target="title">
    </label>

    <label>
        Texte alternatif
        <input data-neox-media-library-target="alt">
    </label>

    <label>
        Description
        <textarea rows="5" data-neox-media-library-target="description"></textarea>
    </label>

    <div class="neox-media-meta" data-neox-media-library-target="meta"></div>

    <div class="neox-media-inspector-actions">
        <button type="button" class="downloadBtn" data-action="neox-media-library#download" data-neox-media-library-target="downloadBtn" title="Télécharger">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </button>
        <button type="button" data-action="neox-media-library#copyUrl" title="Copier l'URL">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        </button>
        <button type="button" class="saveBtn" data-action="neox-media-library#save" data-neox-media-library-target="saveBtn" title="Enregistrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
        </button>
        <button type="button" class="danger" data-action="neox-media-library#remove" data-neox-media-library-target="removeBtn" title="Supprimer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        </button>
    </div>
</aside>
